generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
 MALE
 FEMALE
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  name String
  surname String
  passwordHash String
  profilePhotoUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cats Cat[]
}

model Cat {
  id Int @id @default(autoincrement())
  ownerId Int 
  owner User @relation(fields: [ownerId],references: [id])
  name String
  breed String?
  birthDate DateTime?
  sex Sex?
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photoUrl String?
}
