generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
 MALE
 FEMALE
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  name String
  surname String
  passwordHash String
  profilePhotoUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cats Cat[]
  sitterProfile SitterProfile?
}

model SitterProfile {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  bio        String
  hourlyRate Decimal?
  city String
  address String?
  experienceInYears Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id])
}

model Cat {
  id Int @id @default(autoincrement())
  ownerId Int 
  owner User @relation(fields: [ownerId],references: [id])
  name String
  breed String?
  birthDate DateTime?
  sex Sex?
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photoUrl String?
}
